//@version=5
strategy("Adaptive Ehlers Percentile Reclaim Strategy (Plan B 1.0x)", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, process_orders_on_close=false)

// ==========================================
// 1. INPUTS & PARAMETERS
// ==========================================
string stratMode      = input.string("Plan B (1.0x Pure Spot)", "Strategy Mode", options=["Plan B (1.0x Pure Spot)", "Plan B (1.20x Bull Boost)", "Plan A (1.5% Buffer)"], group="Strategy Mode")
int   maMin           = input.int(3, "Min Adaptive MA Length", minval=1, group="Adaptive Moving Average")
int   maMax           = input.int(30, "Max Adaptive MA Length", minval=5, group="Adaptive Moving Average")
int   volLen          = input.int(12, "Volatility StDev Length", minval=2, group="Adaptive Moving Average")
int   ehlersLen       = input.int(9, "Ehlers Filter Length", minval=2, group="Ehlers Distance-Weighted Filter")
int   ehlersMom       = input.int(12, "Ehlers Momentum Lookback", minval=1, group="Ehlers Distance-Weighted Filter")
int   pctLen          = input.int(40, "Percentile Channel Length", minval=5, group="Percentile Bands")
float pctLevel        = input.float(75.0, "Percentile Rank Level", minval=50.0, maxval=99.0, group="Percentile Bands")
float upperMult       = input.float(0.7, "Upper Band Multiplier", step=0.1, group="Percentile Bands")
float lowerMult       = input.float(0.8, "Lower Band Multiplier", step=0.1, group="Percentile Bands")
float exitWeight      = input.float(0.6, "Plan B Exit Floor TrendMA Weight", step=0.05, group="Plan B Settings")
float planABufferPct  = input.float(1.5, "Plan A Buffer %", step=0.1, group="Plan A Settings") / 100.0

// ==========================================
// 2. INDICATOR MATHEMATICS (CAUSAL LTI)
// ==========================================
float deltaP = close - close[1]
float s = ta.stdev(deltaP, volLen)
float sAvg = ta.sma(s, volLen)
float sMin = sAvg * 0.25
float sMax = sAvg * 1.75
float volRange = sMax - sMin
float adaptLen = volRange > 0 ? (s <= sMin ? maMax : s >= sMax ? maMin : maMax - (maMax - maMin) * (s - sMin) / volRange) : maMax
float alpha = 2.0 / (adaptLen + 1.0)

var float adaptMA = na
adaptMA := na(adaptMA[1]) ? close : adaptMA[1] + alpha * (close - adaptMA[1])

float num = 0.0
float denom = 0.0
for i = 0 to ehlersLen - 1
    float w = math.abs(adaptMA[i] - nz(adaptMA[i + ehlersMom]))
    num += w * adaptMA[i]
    denom += w
float trendMA = denom != 0 ? num / denom : adaptMA

float dev = math.abs(close - trendMA)
float pctDist = ta.percentile_nearest_rank(dev, pctLen, pctLevel)
float upperBand = trendMA + pctDist * upperMult
float lowerBand = trendMA - pctDist * lowerMult

var int SQ = 0
if close > upperBand
    SQ := 1
else if close < lowerBand
    SQ := -1

color barCol = SQ == 1 ? color.rgb(57, 255, 20) : color.rgb(138, 43, 226)
barcolor(barCol)

// Dynamic exit trailing line for Plan B
float midLowerBand = trendMA * exitWeight + lowerBand * (1.0 - exitWeight)

// Plots
plot(trendMA, "Ehlers TrendMA", color=color.orange, linewidth=2)
pUpper = plot(upperBand, "Upper Band", color=color.new(color.green, 30), linewidth=1)
pLower = plot(lowerBand, "Lower Band (Reclaim Line)", color=color.new(color.purple, 20), linewidth=2)
fill(pUpper, pLower, color=color.new(barCol, 92), title="Channel Fill")

plot(stratMode == "Plan A (1.5% Buffer)" ? lowerBand * (1.0 - planABufferPct) : na, "Plan A Buffer Stop", color=color.red, style=plot.style_linebr, linewidth=1)
plot(stratMode != "Plan A (1.5% Buffer)" ? midLowerBand : na, "Plan B Mid-Lower Exit Floor", color=color.aqua, style=plot.style_linebr, linewidth=1)

// ==========================================
// 3. STATE MACHINE ENGINE
// ==========================================
var bool hadBreakdown = false
var bool inPos = false
var bool reachedUpper = false

bool buySignal = false
bool sellSignal = false

if not inPos
    if SQ == -1 and close < lowerBand
        hadBreakdown := true
    // Buy Trigger: Purple bar after breakdown reclaims LowerBand
    if hadBreakdown and SQ == -1 and close > lowerBand
        buySignal := true
        inPos := true
        hadBreakdown := false
        reachedUpper := false
else
    if close > upperBand
        reachedUpper := true
        
    if stratMode == "Plan A (1.5% Buffer)"
        if close < lowerBand * (1.0 - planABufferPct)
            sellSignal := true
            inPos := false
            hadBreakdown := true
    else // Plan B
        float exitFloor = reachedUpper ? midLowerBand : lowerBand
        if close < exitFloor
            sellSignal := true
            inPos := false
            hadBreakdown := true

// Visual Markers
plotshape(buySignal, title="Buy: Reclaim LowerBand", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(sellSignal, title="Sell: Exit Floor Break", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.white)

// ==========================================
// 4. STRATEGY EXECUTION (NEXT-BAR OPEN)
// ==========================================
if buySignal
    strategy.entry("Long", strategy.long)
if sellSignal
    strategy.close("Long")

// Alerts
alertcondition(buySignal, title="Ehlers Reclaim Buy Alert", message="Ehlers Reclaim Buy Signal on {{ticker}} at {{close}}")
alertcondition(sellSignal, title="Ehlers Exit Alert", message="Ehlers Strategy Exit Signal on {{ticker}} at {{close}}")
